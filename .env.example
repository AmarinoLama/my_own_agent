# Plantilla de configuración: copia este archivo como .env y rellénalo.

# API del modelo conversacional
API_CHATGPT=thk_live_...
API_CHATGPT_BASE_URL=https://tokenharbor.ai/v1
API_CHATGPT_MODEL=deepseek-v4.1-flash:free
API_CHATGPT_FALLBACK=deepseek-v4.1-flash:free

# Agente y memoria
AGENTE_NOMBRE=Agente
AGENTE_IDIOMA=es-ES
# AGENTE_MEMORIA=./memoria

# Voz gratuita en español de España (requiere Internet, no API key)
VOZ_MOTOR=edge
EDGE_TTS_VOICE=es-ES-AlvaroNeural
VOZ_EDGE_BACKEND=auto

# Reconocimiento: auto usa Whisper local si está instalado; si no, Google es-ES.
VOZ_TRANSCRIPCION=auto
VOZ_MODELO_WHISPER=base

# Umbral de palmada opcional (PCM pico 0-32767); por defecto se calibra al arrancar.
# AGENTE_PALMADA_UMBRAL=3500

# Alternativa local de Windows o Fish Audio opcional
# VOZ_MOTOR=sapi
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_VOICE_ID=
# FISH_AUDIO_ENDPOINT=https://api.fish.audio/v1/tts
