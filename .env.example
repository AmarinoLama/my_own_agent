# Plantilla de configuración: copia este archivo como .env y rellénalo.

# API del modelo conversacional
API_CHATGPT=sk-...
API_CHATGPT_BASE_URL=https://api.xkiro.com/v1
API_CHATGPT_MODEL=mistralai/mistral-large-2512
API_CHATGPT_FALLBACK=qwen/qwen3.7-plus:free

# Agente y memoria
AGENTE_NOMBRE=Agente
AGENTE_IDIOMA=es-ES
# AGENTE_MEMORIA=./memoria

# Voz de salida (opcional): SAPI usa David de Windows por defecto.
# Para Fish Audio, pon el API key y el identificador de tu voz.
# El identificador suele aparecer como Voice ID/Model ID en Fish Audio.
VOZ_MOTOR=sapi
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
# FISH_AUDIO_ENDPOINT=https://api.fish.audio/v1/tts
