{
  "manifest_version": 2,
  "name": "Cardpilot · Importador Cardmarket",
  "version": "1.0.0",
  "description": "Importa datos visibles de una lista de wants de Cardmarket a tu optimizador local, solo cuando tú lo pides.",
  "permissions": ["activeTab", "tabs", "http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "browser_action": {
    "default_title": "Importar esta página Cardmarket",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.svg"
    }
  },
  "icons": {
    "48": "icon.svg"
  },
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
